# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (for login) — from Google Cloud Console > APIs & Services > Credentials
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxx

# Google Sheets (the "database")
GOOGLE_SHEET_ID=the-id-from-your-sheet-url
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...paste the whole downloaded JSON key here on one line...}
